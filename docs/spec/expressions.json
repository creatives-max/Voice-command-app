{
  "description": "Shared test vectors for the VoiceControl flow expression language. Used by the Android engine, the backend validator and the dashboard simulator so all three evaluate identically. today() is fixed to 2026-10-01.",
  "vars": {
    "name": "Rahul Sharma",
    "first": "Rahul",
    "last": "Sharma",
    "married": "Yes",
    "kids": "2",
    "age": "34",
    "city": "",
    "pin": "110 001",
    "answer": "haan"
  },
  "cases": [
    { "expr": "1 + 2 * 3", "expected": 7 },
    { "expr": "(1 + 2) * 3", "expected": 9 },
    { "expr": "10 / 4", "expected": 2.5 },
    { "expr": "7 % 3", "expected": 1 },
    { "expr": "-age + 40", "expected": 6 },
    { "expr": "kids + 1", "expected": 3 },
    { "expr": "first + ' ' + last", "expected": "Rahul Sharma" },
    { "expr": "\"Hi \" + first", "expected": "Hi Rahul" },
    { "expr": "married == 'yes'", "expected": true },
    { "expr": "married != 'no'", "expected": true },
    { "expr": "age >= 18 && age < 60", "expected": true },
    { "expr": "age > 40 || kids == 2", "expected": true },
    { "expr": "!(age > 40)", "expected": true },
    { "expr": "not empty(city) or kids > 1", "expected": true },
    { "expr": "empty(city)", "expected": true },
    { "expr": "empty(unknownVariable)", "expected": true },
    { "expr": "unknownVariable == ''", "expected": true },
    { "expr": "upper(first)", "expected": "RAHUL" },
    { "expr": "lower(last)", "expected": "sharma" },
    { "expr": "trim('  a b  ')", "expected": "a b" },
    { "expr": "len(name)", "expected": 12 },
    { "expr": "contains(name, 'sharma')", "expected": true },
    { "expr": "startsWith(name, 'Rah')", "expected": true },
    { "expr": "endsWith(name, 'x')", "expected": false },
    { "expr": "concat(first, '-', kids)", "expected": "Rahul-2" },
    { "expr": "digits(pin)", "expected": "110001" },
    { "expr": "left(name, 5)", "expected": "Rahul" },
    { "expr": "right(name, 6)", "expected": "Sharma" },
    { "expr": "round(10 / 3)", "expected": 3 },
    { "expr": "number('42') + 1", "expected": 43 },
    { "expr": "if(kids > 1, 'family', 'single')", "expected": "family" },
    { "expr": "yes(answer)", "expected": true },
    { "expr": "yes(married) && !yes('nahi')", "expected": true },
    { "expr": "today()", "expected": "01/10/2026" },
    { "expr": "year()", "expected": 2026 },
    { "expr": "true && false", "expected": false },
    { "expr": "null == ''", "expected": true },
    { "expr": "'2' == 2", "expected": true },
    { "expr": "'abc' < 'abd'", "expected": true }
  ],
  "errors": [
    { "expr": "1 +", "reason": "unexpected end" },
    { "expr": "(1 + 2", "reason": "missing )" },
    { "expr": "nosuchfn(1)", "reason": "unknown function" },
    { "expr": "'unterminated", "reason": "unterminated string" },
    { "expr": "a b", "reason": "unexpected token" },
    { "expr": "upper()", "reason": "wrong argument count" }
  ]
}
